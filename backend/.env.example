# NAM SA' Backend — Google Cloud Configuration

# Google Cloud Project
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# --- OPTION A: Google AI Studio (development) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-from-aistudio

# --- OPTION B: Vertex AI (production) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Live API model (voice streaming via ADK)
# Google AI Studio:  gemini-2.5-flash-native-audio-preview-12-2025
# Vertex AI:         gemini-live-2.5-flash-native-audio
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Text model (REST chat/translate)
GEMINI_TUNED_MODEL=gemini-2.5-flash

# After fine-tuning, use your tuned model endpoint:
# GEMINI_TUNED_MODEL=projects/PROJECT_ID/locations/us-central1/endpoints/ENDPOINT_ID

# Server
PORT=8080
